{
   "name": "aaix/laravel-error-audit",
   "description": "AI-assisted daily audit of Laravel log errors and warnings, delivered by email.",
   "keywords": ["laravel", "logs", "monitoring", "ai", "error-reporting", "audit"],
   "type": "library",
   "license": "MIT",
   "authors": [
      {
         "name": "Jonas Gnioui",
         "email": "jonaaix@icloud.com"
      }
   ],
   "require": {
      "php": "^8.3",
      "illuminate/bus": "^12.0|^13.0",
      "illuminate/console": "^12.0|^13.0",
      "illuminate/database": "^12.0|^13.0",
      "illuminate/mail": "^12.0|^13.0",
      "illuminate/support": "^12.0|^13.0",
      "aaix/laravel-ai-costs": "^1.1",
      "laravel/ai": "^0"
   },
   "autoload": {
      "psr-4": {
         "Aaix\\LaravelErrorAudit\\": "src/"
      }
   },
   "require-dev": {
      "orchestra/testbench": "^11.0",
      "pestphp/pest": "^3.0|^4.0"
   },
   "autoload-dev": {
      "psr-4": {
         "Aaix\\LaravelErrorAudit\\Tests\\": "tests/"
      }
   },
   "scripts": {
      "test": "pest",
      "demo": "pest --filter=\"demo report\""
   },
   "extra": {
      "laravel": {
         "providers": [
            "Aaix\\LaravelErrorAudit\\ErrorAuditServiceProvider"
         ]
      },
      "branch-alias": {
         "dev-main": "1.x-dev"
      }
   },
   "config": {
      "sort-packages": true,
      "allow-plugins": {
         "pestphp/pest-plugin": true
      }
   },
   "minimum-stability": "dev",
   "prefer-stable": true
}
